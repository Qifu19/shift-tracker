# Kopieer dit bestand naar .env en vul je eigen waarden in.
# Zet .env NOOIT op GitHub; dit voorbeeldbestand mag wel.

# Neon: de directe link (voor migraties) en de link met -pooler (voor de app)
DATABASE_URL="postgresql://gebruiker:wachtwoord@host/neondb?sslmode=require"
DATABASE_URL_POOLED="postgresql://gebruiker:wachtwoord@host-pooler/neondb?sslmode=require"

# Better Auth: een willekeurige geheime sleutel van minstens 32 tekens.
# Maak er een met: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
